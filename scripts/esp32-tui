#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ "${1:-}" == '--help' ]]; then
  printf '%s\n' '사용법: bash scripts/esp32-tui [--demo] [--no-connect] [--port 8787]' \
    '1/2/3 보드 선택 · r 조회 · h 설정 안내 · 방향키 스크롤 · q 종료' \
    'CLI/자동화: bash scripts/esp32-tui --json [esp32-scan 옵션]' \
    '최초 설치: cd apps/esp32-tui && npm ci (앱 폴더에만 설치)'
  exit 0
fi
if [[ "${1:-}" == '--json' ]]; then
  exec bash "$ROOT_DIR/scripts/esp32-scan" --ensure-console "$@"
fi
APP_DIR="$ROOT_DIR/apps/esp32-tui"
if [[ ! -x "$APP_DIR/node_modules/.bin/bun" ]]; then
  printf '%s\n' 'TUI 의존성이 없습니다. cd apps/esp32-tui && npm ci 를 먼저 실행하세요.' >&2
  exit 2
fi
cd "$APP_DIR"
exec "$APP_DIR/node_modules/.bin/bun" run src/index.ts "$@"
