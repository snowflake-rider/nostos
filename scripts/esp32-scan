#!/usr/bin/env bash
# Inspect only the three known NOSTOS boards. Never install dependencies implicitly.
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
if [[ -n "${ESP32_SCAN_PYTHON:-}" ]]; then
  exec "$ESP32_SCAN_PYTHON" -B -u "$ROOT_DIR/scripts/esp32_scan.py" "$@"
elif [[ -x "$ROOT_DIR/apps/mesh-console/.venv/bin/python" ]]; then
  exec "$ROOT_DIR/apps/mesh-console/.venv/bin/python" -B -u "$ROOT_DIR/scripts/esp32_scan.py" "$@"
else
  exec python3 -B -u "$ROOT_DIR/scripts/esp32_scan.py" "$@"
fi
