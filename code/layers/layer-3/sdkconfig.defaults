# 현재 ESP32-S3 N16R8 보드의 실제 SPI flash 크기다.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Layer 3은 BLE-only Bluedroid host와 Legacy Active Scanning을 사용한다.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_SCAN_EN=y

# Scanner-only Layer이므로 GATT와 security 기능은 사용하지 않는다.
# CONFIG_BT_GATTS_ENABLE is not set
# CONFIG_BT_GATTC_ENABLE is not set
# CONFIG_BT_BLE_SMP_ENABLE is not set
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
