diff --git a/firmware/stm32/MyApp/hw/button.c b/firmware/stm32/MyApp/hw/button.c
index a63d433..acdd18f 100644
--- a/firmware/stm32/MyApp/hw/button.c
+++ b/firmware/stm32/MyApp/hw/button.c
@@ -19,10 +19,11 @@ typedef struct
 } button_state_t;
 
 static button_state_t buttons[] = {
-    {BTN1_GPIO_Port, BTN1_Pin, MSG_SPEED_DOWN_REQUEST, false, false, 0U},
-    {BTN2_GPIO_Port, BTN2_Pin, MSG_SPEED_UP_REQUEST, false, false, 0U},
-    {BTN3_GPIO_Port, BTN3_Pin, MSG_SAFETY_REMINDER, false, false, 0U},
-    {BTN4_GPIO_Port, BTN4_Pin, MSG_STOP_REQUEST, false, false, 0U},
+    /* 보드 D4/D6/D7/D9 순서: 가속, 감속, 안전 알림, 정지 요청. */
+    {BTN1_SPEED_UP_GPIO_Port, BTN1_SPEED_UP_Pin, MSG_SPEED_UP_REQUEST, false, false, 0U},
+    {BTN2_SPEED_DOWN_GPIO_Port, BTN2_SPEED_DOWN_Pin, MSG_SPEED_DOWN_REQUEST, false, false, 0U},
+    {BTN3_SAFETY_GPIO_Port, BTN3_SAFETY_Pin, MSG_SAFETY_REMINDER, false, false, 0U},
