menu "NOSTOS message protocol"
config NOSTOS_PROTOCOL_V2
    bool "Use framed v2 protocol (all connected STM32/ESP32 must use v2)"
    default n
config NOSTOS_LOCAL_SOURCE
    int "Local rider/source (1..3)"
    range 1 3
    default 1
    depends on NOSTOS_PROTOCOL_V2
config NOSTOS_SOURCE1_ADDRESS
    hex "Provisioned Mesh address for source1 (0 disables startup)"
    range 0x0 0x7fff
    default 0x0
    depends on NOSTOS_PROTOCOL_V2
config NOSTOS_SOURCE2_ADDRESS
    hex "Provisioned Mesh address for source2 (0 disables startup)"
    range 0x0 0x7fff
    default 0x0
    depends on NOSTOS_PROTOCOL_V2
config NOSTOS_SOURCE3_ADDRESS
    hex "Provisioned Mesh address for source3 (0 disables startup)"
    range 0x0 0x7fff
    default 0x0
    depends on NOSTOS_PROTOCOL_V2
endmenu
