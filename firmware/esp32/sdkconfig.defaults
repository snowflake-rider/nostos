# ESP32-S3 Bluetooth controller and Bluedroid host
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_GATTS_SEND_SERVICE_CHANGE_MANUAL=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4512
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Standard Bluetooth Mesh node, provisionable by iPhone over PB-GATT.
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
# NOSTOS uses the stable Mesh 1.0 feature set; no Mesh 1.1 preview model is used.
CONFIG_BLE_MESH_V11_SUPPORT=n
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_RELAY=y
CONFIG_BLE_MESH_HEALTH_SRV=y
# The firmware never tears down Mesh at runtime; reboot clears volatile state.
CONFIG_BLE_MESH_DEINIT=n
# NOSTOS uses only foundation servers and one Vendor Model; no Generic Model.
CONFIG_BLE_MESH_GENERIC_SERVER=n
CONFIG_BLE_MESH_TX_SEG_MSG_COUNT=10
CONFIG_BLE_MESH_RX_SEG_MSG_COUNT=10
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BLE_MESH_SUPPORT_BLE_SCAN=y

# One identical image binds source1/2/3 from the verified
# provisioned Mesh primary map 0x0003/0x0005/0x0006 at runtime.
CONFIG_NOSTOS_SOURCE1_ADDRESS=0x3
CONFIG_NOSTOS_SOURCE2_ADDRESS=0x5
CONFIG_NOSTOS_SOURCE3_ADDRESS=0x6
CONFIG_NOSTOS_SOURCE4_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE5_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE6_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE7_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE8_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE9_ADDRESS=0x0
CONFIG_NOSTOS_SOURCE10_ADDRESS=0x0
CONFIG_NOSTOS_RIDE_PUBLISHER_SOURCE=1
CONFIG_NOSTOS_ENVIRONMENT_PUBLISHER_SOURCE=2
CONFIG_NOSTOS_XOSS_SPEED_SENSOR=y
CONFIG_NOSTOS_XOSS_DEVICE_NAME="XOSS S-26518"
CONFIG_NOSTOS_XOSS_WHEEL_CIRCUMFERENCE_MM=2100
CONFIG_NOSTOS_XOSS_STALE_MS=3000

# USB is the command and log console. UART1 is reserved for NOSTOS frames.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
